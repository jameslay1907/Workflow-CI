name: CI-mlflow
 
conda_env: conda.yaml
 
entry_points:
  main:
    parameters:
      n_estimators: {type: int, default: 200}
      max_depth: {type: int, default: 6}
      learning_rate: {type: float, default: 0.05}
      dataset : {type: string, default: "ai_student_impact_preprocessing"}
    command: "python modelling.py {n_estimators} {max_depth} {learning_rate} {dataset}"
